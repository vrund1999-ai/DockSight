# Copy to .env (backend reads it too). All settings use the DOCKSIGHT_ prefix; see backend/docksight/config.py.
DOCKSIGHT_DATABASE_URL=postgresql+psycopg://docksight:docksight@localhost:5432/docksight
DOCKSIGHT_JWT_SECRET=replace-with-a-long-random-string
DOCKSIGHT_DEMO_USERNAME=analyst
DOCKSIGHT_DEMO_PASSWORD=docksight
